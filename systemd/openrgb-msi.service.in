[Unit]
Description=OpenRGB SDK server for MSI Mystic Light (DMI board-name shim)
Documentation=https://gitlab.com/CalcProgrammer1/OpenRGB
After=graphical-session.target

[Service]
Type=simple
# OpenRGB identifies MSI motherboards by an exact match on "MSI " + the DMI
# board_name. Boards missing from its compiled-in table are skipped with
# "does not have valid config". The shim changes only what OpenRGB sees.
#
# MSI_SPOOF_BOARD_NAME is the board_name only -- OpenRGB prepends "MSI ".
# Quoted because board names contain spaces; without this systemd parses the
# remainder of the line as further assignments and drops the value.
Environment="MSI_SPOOF_BOARD_NAME=@SPOOF@"
Environment="LD_PRELOAD=@LIBDIR@/dmi_spoof.so"
ExecStart=/usr/bin/openrgb --server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target